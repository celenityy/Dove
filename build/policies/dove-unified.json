{
    "policies": {
        "3rdparty": {
            "Extensions": {
                "uBlock0@raymondhill.net": {
                    "adminSettings": {
                        "assetsBootstrapLocation": "https://gitlab.com/celenityy/Dove/-/raw/pages/uBlock/assets.json"
                    }
                },
                "dkim_verifier@pl": {
                    "arh.read": true,
                    "arh.replaceAddonResult": false,
                    "debug": false,
                    "display.favicon.show": true,
                    "display.keySecure": true,
                    "dkim.enable": true,
                    "dns.nameserver": "9.9.9.9",
                    "error.algorithm.rsa.weakKeyLength.treatAs": 1,
                    "error.algorithm.sign.rsa-sha1.treatAs": 1,
                    "error.detailedReasons": true,
                    "error.illformed_i.treatAs": 1,
                    "error.illformed_s.treatAs": 1,
                    "error.policy.key_insecure.treatAs": 1,
                    "key.storing": 2,
                    "policy.dkim.unsignedHeadersWarning.mode": 30,
                    "policy.DMARC.shouldBeSigned.enable": true,
                    "policy.DMARC.shouldBeSigned.neededPolicy": "none",
                    "policy.signRules.autoAddRule.enable": true,
                    "policy.signRules.autoAddRule.for": 0,
                    "policy.signRules.autoAddRule.onlyIfFromAddressInSDID": true,
                    "policy.signRules.checkDefaultRules": true,
                    "policy.signRules.enable": true,
                    "policy.signRules.error.wrong_sdid.asWarning": false,
                    "policy.signRules.sdid.allowSubDomains": false,
                    "saveResult": true,
                    "showDKIMFromTooltip": 50,
                    "showDKIMHeader": 50
                }
            }
        },
        "ExtensionSettings": {
            "*": {
                "blocked_install_message": "I am Iron Man.",
                "allowed_types": [
                    "extension",
                    "theme",
                    "dictionary",
                    "locale"
                ]
            },
            "cardbook@vigneau.philippe": {
                "private_browsing": true
            },
            "dkim_verifier@pl": {
                "installation_mode": "normal_installed",
                "install_url": "https://addons.thunderbird.net/thunderbird/downloads/latest/dkim-verifier/latest.xpi",
                "private_browsing": true
            },
            "gconversation@xulforum.org": {
                "private_browsing": true
            },
            "languagetool-mailextension@languagetool.org": {
                "private_browsing": true
            },
            "uBlock0@raymondhill.net": {
                "installation_mode": "normal_installed",
                "install_url": "https://github.com/gorhill/uBlock/releases/download/1.64.0/uBlock0_1.64.0.thunderbird.xpi",
                "private_browsing": true
            }
        },
        "InAppNotification": {
            "DonationEnabled": false,
            "SurveyEnabled": false
        }
    }
}
